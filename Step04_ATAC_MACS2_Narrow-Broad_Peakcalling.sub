#!/bin/bash

# PIPELINE: ATAC-seq preprocessing (fastq -> bam -> bigwig)
# STEP: 4 of 4, PEAKS BRANCH -- MACS2 narrow/broad peak calling on filtered BAMs
# PREV:  Step03_ATAC_Post-Align2dm6-filt_IR_2_.sub
# Parallel to the bigwig branch (Step04A/Step04B) -- not required for bigwig generation.
# See README_ATAC.md for the full pipeline map.

#SBATCH --time=25:00:00
#SBATCH --job-name=atac-MACS2
#SBATCH --nodes=1
#SBATCH --mem=100G
#SBATCH --ntasks=28
#SBATCH --output=Macs2_nrw-brd_peaks-%J.out
#SBATCH --error=Macs2_nrw-brd_peaks-%J.err

# Load environment

##### ---- USER CONFIG: edit these two lines for your own environment ---- #####
PROJECT_DIR="/path/to/your/project"      # replaces old lab-specific data/scripts root
CONDA_BASE="$(conda info --base)"        # or hardcode e.g. "$HOME/miniconda3"
##### ------------------------------------------------------------------- #####
module load java-jdk
source ${CONDA_BASE}/bin/activate atac_env

# Input sample name
BASENAME=$1

# Paths
BAMPATH="${PROJECT_DIR}/ATAC_seq/ATAC_data/Output/${BASENAME}/mapped/"
ATAC_OUT="${PROJECT_DIR}/ATAC_seq/ATAC_data/Output/MACS2_peaks-bigwigs/5.25.26"
mkdir -p "${ATAC_OUT}"

# Suffix mapping (unfiltered "noq" BAMs only -- this is the only variant we deposit/report)
declare -A BAM_TYPES=(
    ["noq_openChromatin"]="_noq_openChromatin.bam"
    ["noq_rmdup_noChrM"]="_noq_rmdup.noChrM.bam"
)

# Loop and call MACS2 if BAM exists
for label in "${!BAM_TYPES[@]}"; do
    SUFFIX="${BAM_TYPES[$label]}"
    FILE="${BAMPATH}${BASENAME}${SUFFIX}"

    if [[ ! -f "$FILE" ]]; then
        echo "INFO: Skipping missing file for $label: $FILE"
        continue
    fi

    echo "Running MACS2 for $label"

    # Narrow peaks
    macs2 callpeak \
        --treatment "$FILE" \
        --gsize 1.2e8 \
        --name "${BASENAME}_q0.05_${label}_Macs2_narrow" \
        --format BAMPE -B \
        --keep-dup all \
        --outdir "$ATAC_OUT" \
        --qvalue 0.05

    # Broad peaks
    macs2 callpeak \
        --treatment "$FILE" \
        --gsize 1.2e8 \
        --name "${BASENAME}_q0.05_${label}_Macs2_broad" \
        --format BAMPE -B \
        --broad \
        --broad-cutoff 0.05 \
        --keep-dup all \
        --outdir "$ATAC_OUT" \
        --qvalue 0.05
done

echo "MACS2 peak calling complete for '${BASENAME}'"
echo "Output saved to: ${ATAC_OUT}"

