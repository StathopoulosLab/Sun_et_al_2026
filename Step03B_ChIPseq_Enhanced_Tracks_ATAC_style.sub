mkdir -p ${OUTPUT_DIR}

# Effective genome size for dm6
GENOME_SIZE=142573017

###########################
# Define Sample BAMs
###########################
RUNTAB_04="${BASE}/Output/Dm_ChIP_RuntAb_04_i4_IR/mapped/Dm_ChIP_RuntAb_04_i4_IR.dedup.nochrM.bam"
RUNTAB_03="${BASE}/Output/Dm_ChIP_RuntAb_03_i19_IR/mapped/Dm_ChIP_RuntAb_03_i19_IR.dedup.nochrM.bam"

# Define Control BAMs
POOLED_INPUT="${BASE}/Output/pooled_controls/INPUT_pooled.sorted.bam"
