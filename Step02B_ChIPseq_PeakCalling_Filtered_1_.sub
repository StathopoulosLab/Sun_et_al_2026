#!/bin/bash
#SBATCH --time=10:00:00
#SBATCH --job-name=ChIP_Peak_Filtered
#SBATCH --nodes=1
#SBATCH --mem=64G
#SBATCH --ntasks=12
#SBATCH --output=ChIP_PeakFiltered-%J.out
#SBATCH --error=ChIP_PeakFiltered-%J.err
#SBATCH --mail-user=<your_email>@example.edu
#SBATCH --mail-type=END


##### ---- USER CONFIG: edit these two lines for your own environment ---- #####
PROJECT_DIR="/path/to/your/project"      # replaces old lab-specific data/scripts root
CONDA_BASE="$(conda info --base)"        # or hardcode e.g. "$HOME/miniconda3"
##### ------------------------------------------------------------------- #####
source ${CONDA_BASE}/bin/activate atac_env

###########################
# COMPREHENSIVE PEAK CALLING WITH FILTERED BAMs
# Based on Step02 but uses filtered BAMs for cleaner peaks
###########################

###########################
# Paths & Sample Names
###########################
BASE="${PROJECT_DIR}/ChIP_seq/ChIP_data"
POOLED_DIR="${BASE}/Output/pooled_controls_filtered"

mkdir -p ${POOLED_DIR}

# Effective genome size for dm6 (Drosophila)
GENOME_SIZE=142573017

###########################
# Define Filtered ChIP BAMs
###########################
RUNTAB_04="${BASE}/Output/Dm_ChIP_RuntAb_04_i4_IR/mapped_filtered/Dm_ChIP_RuntAb_04_i4_IR.filtered.sorted.bam"
RUNTAB_03="${BASE}/Output/Dm_ChIP_RuntAb_03_i19_IR/mapped_filtered/Dm_ChIP_RuntAb_03_i19_IR.filtered.sorted.bam"

###########################
# Define Filtered Control BAMs
###########################
POOLED_INPUT="${POOLED_DIR}/INPUT_pooled.sorted.bam"
IGG="${POOLED_DIR}/IgG.sorted.bam"

# Check if pooled controls exist
if [ ! -f "${POOLED_INPUT}" ]; then
    echo "ERROR: Filtered pooled INPUT not found!"
    echo "Please run Step01C_Merge_Filtered_Controls.sub first!"
    exit 1
fi

if [ ! -f "${IGG}" ]; then
    echo "WARNING: Filtered IgG not found at ${IGG}"
    echo "Will proceed with INPUT controls only..."
    USE_IGG=false
else
    echo "Filtered IgG control found: ${IGG}"
    USE_IGG=true
fi

###########################
# Helper function: MACS2 with specific stringency
###########################
run_macs2_stringency() {
    CHIP_BAM=$1
    CONTROL_BAM=$2
    OUT_DIR=$3
    BASE_NAME=$4
    THRESHOLD_TYPE=$5  # "q" or "p"
    THRESHOLD_VALUE=$6  # e.g., 0.01 or 0.05

    SUFFIX="${THRESHOLD_TYPE}${THRESHOLD_VALUE}"
    NAME="${BASE_NAME}_${SUFFIX}"
    
    echo "Calling peaks for ${NAME}..."
    
    # Call narrow peaks with summits
    if [ "${THRESHOLD_TYPE}" == "q" ]; then
        macs2 callpeak \
            -t ${CHIP_BAM} \
            -c ${CONTROL_BAM} \
            -f BAMPE \
            -g dm \
            -n ${NAME}_narrow \
            --outdir ${OUT_DIR} \
            -q ${THRESHOLD_VALUE} \
            --keep-dup all \
            --call-summits
    else  # p-value
        macs2 callpeak \
            -t ${CHIP_BAM} \
            -c ${CONTROL_BAM} \
            -f BAMPE \
            -g dm \
            -n ${NAME}_narrow \
            --outdir ${OUT_DIR} \
            -p ${THRESHOLD_VALUE} \
            --keep-dup all \
            --call-summits
    fi

    # Call broad peaks (without summits)
    if [ "${THRESHOLD_TYPE}" == "q" ]; then
        macs2 callpeak \
            -t ${CHIP_BAM} \
            -c ${CONTROL_BAM} \
            -f BAMPE \
            -g dm \
            -n ${NAME}_broad \
            --outdir ${OUT_DIR} \
            -q ${THRESHOLD_VALUE} \
            --keep-dup all \
            --broad
    else  # p-value
        macs2 callpeak \
            -t ${CHIP_BAM} \
            -c ${CONTROL_BAM} \
            -f BAMPE \
            -g dm \
            -n ${NAME}_broad \
            --outdir ${OUT_DIR} \
            -p ${THRESHOLD_VALUE} \
            --keep-dup all \
            --broad \
            --broad-cutoff 0.1
    fi

    # Filter narrow peaks to standard chromosomes
    if [ -f "${OUT_DIR}/${NAME}_narrow_peaks.narrowPeak" ]; then
        awk '$1 ~ /^chr(2L|2R|3L|3R|4|X|Y)$/' \
            ${OUT_DIR}/${NAME}_narrow_peaks.narrowPeak \
            > ${OUT_DIR}/${NAME}_peaks.filtered.narrowPeak
        
        PEAK_COUNT=$(wc -l < ${OUT_DIR}/${NAME}_peaks.filtered.narrowPeak)
        echo "  ${NAME}: ${PEAK_COUNT} filtered narrow peaks"
    fi
    
    # Filter broad peaks to standard chromosomes
    if [ -f "${OUT_DIR}/${NAME}_broad_peaks.broadPeak" ]; then
        awk '$1 ~ /^chr(2L|2R|3L|3R|4|X|Y)$/' \
            ${OUT_DIR}/${NAME}_broad_peaks.broadPeak \
            > ${OUT_DIR}/${NAME}_peaks.filtered.broadPeak
        
        PEAK_COUNT=$(wc -l < ${OUT_DIR}/${NAME}_peaks.filtered.broadPeak)
        echo "  ${NAME}: ${PEAK_COUNT} filtered broad peaks"
    fi
}

###########################
# Helper function: Generate BigWig files (once per sample/control pair)
###########################
generate_bigwigs() {
    CHIP_BAM=$1
    CONTROL_BAM=$2
    OUT_DIR=$3
    BASE_NAME=$4

    echo "Generating BigWig files for ${BASE_NAME}..."
    
    # ChIP BigWigs
    bamCoverage \
        -b ${CHIP_BAM} \
        -o ${OUT_DIR}/${BASE_NAME}_bin10.bw \
        --binSize 10 \
        --normalizeUsing RPGC \
        --effectiveGenomeSize ${GENOME_SIZE} \
        -p 8

    bamCoverage \
        -b ${CHIP_BAM} \
        -o ${OUT_DIR}/${BASE_NAME}_bin50_smooth.bw \
        --binSize 50 \
        --smoothLength 150 \
        --normalizeUsing RPGC \
        --effectiveGenomeSize ${GENOME_SIZE} \
        -p 8

    # Control BigWigs
    bamCoverage \
        -b ${CONTROL_BAM} \
        -o ${OUT_DIR}/${BASE_NAME}_control_bin10.bw \
        --binSize 10 \
        --normalizeUsing RPGC \
        --effectiveGenomeSize ${GENOME_SIZE} \
        -p 8

    bamCoverage \
        -b ${CONTROL_BAM} \
        -o ${OUT_DIR}/${BASE_NAME}_control_bin50_smooth.bw \
        --binSize 50 \
        --smoothLength 150 \
        --normalizeUsing RPGC \
        --effectiveGenomeSize ${GENOME_SIZE} \
        -p 8

    echo "BigWig generation complete for ${BASE_NAME}"
}

###########################
# Main function: Run all stringencies for a sample
###########################
run_all_stringencies() {
    CHIP_BAM=$1
    CONTROL_BAM=$2
    OUT_DIR=$3
    BASE_NAME=$4

    mkdir -p ${OUT_DIR}

    echo "==================================="
    echo "Processing: ${BASE_NAME}"
    echo "==================================="

    # Run all 4 stringency levels
    run_macs2_stringency ${CHIP_BAM} ${CONTROL_BAM} ${OUT_DIR} ${BASE_NAME} "q" 0.01
    run_macs2_stringency ${CHIP_BAM} ${CONTROL_BAM} ${OUT_DIR} ${BASE_NAME} "q" 0.05
    run_macs2_stringency ${CHIP_BAM} ${CONTROL_BAM} ${OUT_DIR} ${BASE_NAME} "p" 0.01
    run_macs2_stringency ${CHIP_BAM} ${CONTROL_BAM} ${OUT_DIR} ${BASE_NAME} "p" 0.05

    # Generate BigWig files once
    generate_bigwigs ${CHIP_BAM} ${CONTROL_BAM} ${OUT_DIR} ${BASE_NAME}

    echo "==================================="
    echo "Completed: ${BASE_NAME}"
    echo "==================================="
}

###########################
# Run with FILTERED POOLED INPUT controls
###########################
echo ""
echo "####################################################"
echo "# PEAK CALLING WITH FILTERED POOLED INPUT CONTROLS"
echo "####################################################"

run_all_stringencies ${RUNTAB_04} ${POOLED_INPUT} \
    "${BASE}/Output/Dm_ChIP_RuntAb_04_i4_IR/peaks_pooled_input_filtered" \
    "RuntAb_04_vs_pooled_INPUT_filtered"

run_all_stringencies ${RUNTAB_03} ${POOLED_INPUT} \
    "${BASE}/Output/Dm_ChIP_RuntAb_03_i19_IR/peaks_pooled_input_filtered" \
    "RuntAb_03_vs_pooled_INPUT_filtered"

###########################
# Run with FILTERED IgG control (if available)
###########################
if [ "$USE_IGG" = true ]; then
    echo ""
    echo "####################################################"
    echo "# PEAK CALLING WITH FILTERED IgG CONTROL"
    echo "####################################################"
    
    run_all_stringencies ${RUNTAB_04} ${IGG} \
        "${BASE}/Output/Dm_ChIP_RuntAb_04_i4_IR/peaks_IgG_filtered" \
        "RuntAb_04_vs_IgG_filtered"
    
    run_all_stringencies ${RUNTAB_03} ${IGG} \
        "${BASE}/Output/Dm_ChIP_RuntAb_03_i19_IR/peaks_IgG_filtered" \
        "RuntAb_03_vs_IgG_filtered"
fi

###########################
# Create Comparison Summary
###########################
COMPARISON_DIR="${BASE}/Output/control_comparison_filtered"
mkdir -p ${COMPARISON_DIR}

SUMMARY="${COMPARISON_DIR}/peak_counts_by_control.txt"

echo "Creating comparison summary..."
echo -e "Sample\tControl_Type\tThreshold\tNarrow_Peaks\tBroad_Peaks" > ${SUMMARY}

# Function to count peaks
count_peaks() {
    local SAMPLE=$1
    local CONTROL=$2
    local THRESH=$3
    local PATTERN=$4
    
    # Find the directory matching the pattern
    DIR=$(find ${BASE}/Output -type d -name "*${PATTERN}*" 2>/dev/null | head -n 1)
    
    if [ -z "$DIR" ]; then
        echo -e "${SAMPLE}\t${CONTROL}\t${THRESH}\t0\t0" >> ${SUMMARY}
        return
    fi
    
    NARROW="${DIR}/${SAMPLE}_vs_${CONTROL}_${THRESH}_peaks.filtered.narrowPeak"
    BROAD="${DIR}/${SAMPLE}_vs_${CONTROL}_${THRESH}_peaks.filtered.broadPeak"
    
    if [ -f "${NARROW}" ]; then
        N_COUNT=$(wc -l < ${NARROW})
    else
        N_COUNT=0
    fi
    
    if [ -f "${BROAD}" ]; then
        B_COUNT=$(wc -l < ${BROAD})
    else
        B_COUNT=0
    fi
    
    echo -e "${SAMPLE}\t${CONTROL}\t${THRESH}\t${N_COUNT}\t${B_COUNT}" >> ${SUMMARY}
}

# Count peaks for all combinations
for SAMPLE in "RuntAb_04" "RuntAb_03"; do
    for THRESH in "q0.01" "q0.05" "p0.01" "p0.05"; do
        # Filtered Pooled INPUT
        count_peaks ${SAMPLE} "pooled_INPUT_filtered" ${THRESH} "peaks_pooled_input_filtered"
        
        # Filtered IgG (if exists)
        if [ "$USE_IGG" = true ]; then
            count_peaks ${SAMPLE} "IgG_filtered" ${THRESH} "peaks_IgG_filtered"
        fi
    done
done

echo ""
echo "========================================="
echo "FILTERED PEAK COUNT COMPARISON"
echo "========================================="
column -t ${SUMMARY}

###########################
# Create Venn diagram data for peak overlaps
###########################
echo ""
echo "Creating peak overlap analysis..."

OVERLAP_DIR="${COMPARISON_DIR}/overlaps"
mkdir -p ${OVERLAP_DIR}

# Function to find overlapping peaks between two sets
compare_peaks() {
    local SAMPLE=$1
    local THRESH=$2
    
    echo ""
    echo "Comparing ${SAMPLE} at ${THRESH} stringency:"
    
    # Find directories
    POOLED_DIR=$(find ${BASE}/Output -type d -name "*${SAMPLE}*peaks_pooled_input_filtered" 2>/dev/null | head -n 1)
    IGG_DIR=$(find ${BASE}/Output -type d -name "*${SAMPLE}*peaks_IgG_filtered" 2>/dev/null | head -n 1)
    
    if [ -z "$POOLED_DIR" ] || [ -z "$IGG_DIR" ]; then
        echo "  Directories not found, skipping..."
        return
    fi
    
    POOLED_PEAKS="${POOLED_DIR}/${SAMPLE}_vs_pooled_INPUT_filtered_${THRESH}_peaks.filtered.narrowPeak"
    IGG_PEAKS="${IGG_DIR}/${SAMPLE}_vs_IgG_filtered_${THRESH}_peaks.filtered.narrowPeak"
    
    if [ -f "${POOLED_PEAKS}" ] && [ -f "${IGG_PEAKS}" ]; then
        # Find overlaps
        OVERLAP_FILE="${OVERLAP_DIR}/${SAMPLE}_${THRESH}_INPUT_vs_IgG_overlap_filtered.bed"
        bedtools intersect -a ${POOLED_PEAKS} -b ${IGG_PEAKS} -wa > ${OVERLAP_FILE}
        
        POOLED_COUNT=$(wc -l < ${POOLED_PEAKS})
        IGG_COUNT=$(wc -l < ${IGG_PEAKS})
        OVERLAP_COUNT=$(wc -l < ${OVERLAP_FILE})
        
        echo "  Pooled INPUT peaks: ${POOLED_COUNT}"
        echo "  IgG peaks: ${IGG_COUNT}"
        echo "  Overlapping peaks: ${OVERLAP_COUNT}"
        
        # Calculate percentages
        if [ ${POOLED_COUNT} -gt 0 ]; then
            OVERLAP_PCT_INPUT=$(awk -v o=${OVERLAP_COUNT} -v p=${POOLED_COUNT} 'BEGIN {printf "%.1f", (o/p)*100}')
            echo "  ${OVERLAP_PCT_INPUT}% of INPUT peaks also found with IgG"
        fi
        
        if [ ${IGG_COUNT} -gt 0 ]; then
            OVERLAP_PCT_IGG=$(awk -v o=${OVERLAP_COUNT} -v i=${IGG_COUNT} 'BEGIN {printf "%.1f", (o/i)*100}')
            echo "  ${OVERLAP_PCT_IGG}% of IgG peaks also found with INPUT"
        fi
        
        # Save high-confidence peaks (found in both)
        HIGH_CONF="${OVERLAP_DIR}/${SAMPLE}_${THRESH}_high_confidence_filtered.bed"
        cp ${OVERLAP_FILE} ${HIGH_CONF}
        echo "  High-confidence peaks saved to: ${HIGH_CONF}"
    else
        echo "  Peak files not found, skipping..."
    fi
}

# Compare overlaps for each sample and stringency (if IgG was used)
if [ "$USE_IGG" = true ]; then
    for SAMPLE in "RuntAb_04" "RuntAb_03"; do
        for THRESH in "q0.01" "q0.05" "p0.01" "p0.05"; do
            compare_peaks ${SAMPLE} ${THRESH}
        done
    done
fi

###########################
# Final Summary
###########################
echo ""
echo "========================================="
echo "FILTERED PEAK CALLING COMPLETE!"
echo "========================================="
echo ""
echo "Results organized by control type:"
echo ""
echo "1. FILTERED POOLED INPUT controls:"
echo "   Output/Dm_ChIP_RuntAb_*/peaks_pooled_input_filtered/"
echo ""

if [ "$USE_IGG" = true ]; then
    echo "2. FILTERED IgG controls:"
    echo "   Output/Dm_ChIP_RuntAb_*/peaks_IgG_filtered/"
    echo ""
fi

echo "Comparison files:"
echo "   ${COMPARISON_DIR}/"
echo "   - peak_counts_by_control.txt (summary table)"
echo "   - overlaps/ (INPUT vs IgG comparisons)"
echo ""
echo "For each control type, you have:"
echo "  - 4 peak stringencies (q0.01, q0.05, p0.01, p0.05)"
echo "  - BOTH narrow peaks (with summits) AND broad peaks"
echo "  - 2 BigWig visualizations (bin10, bin50_smooth)"
echo ""

if [ "$USE_IGG" = true ]; then
    echo "HIGH-CONFIDENCE FILTERED PEAKS:"
    echo "Peaks found in BOTH INPUT and IgG controls are saved in:"
    echo "   ${OVERLAP_DIR}/*_high_confidence_filtered.bed"
    echo ""
    echo "These represent your most reliable Runt binding sites!"
    echo ""
fi

echo "========================================="
echo "COMPARISON: FILTERED vs UNFILTERED PEAKS"
echo "========================================="
echo ""
echo "Compare peak counts to see improvement from filtering:"
echo ""
echo "UNFILTERED peaks (from original Step02):"
echo "  Output/Dm_ChIP_RuntAb_*/peaks_pooled_input/"
echo ""
echo "FILTERED peaks (from this run):"
echo "  Output/Dm_ChIP_RuntAb_*/peaks_pooled_input_filtered/"
echo ""
echo "Expected: FEWER peaks, but HIGHER QUALITY with filtered BAMs!"
echo ""

echo "DONE!"
