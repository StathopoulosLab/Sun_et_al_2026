#!/bin/bash

#SBATCH --time=12:00:00 #walltime
#SBATCH --job-name=atac-TrimGal      ## Name of the job.
#SBATCH --nodes=1            ## (-N) number of nodes to use
#SBATCH --mem=10G   #memory per CPU core
#SBATCH --ntasks=20           ## (-n) number of tasks to launch ## number of cores the job needs
#SBATCH --output=QC-TrimGal-%J.out ## output log file
#SBATCH --error=QC-TrimGal-%J.err ## error log file
## SBATCH –-mem=0 –p fdr ## fdr ## Enable the fdr indicate req large number of cores and "take over" an entire node without an estimate of cores needed.

	##### Universl Header for Isa's Pipeline of ATACseq Analysis #####


##Load appropriate source directory or conda enviorment and create variables of unique inputs 


##### ---- USER CONFIG: edit these two lines for your own environment ---- #####
PROJECT_DIR="/path/to/your/project"      # replaces old lab-specific data/scripts root
CONDA_BASE="$(conda info --base)"        # or hardcode e.g. "$HOME/miniconda3"
##### ------------------------------------------------------------------- #####
module load openjdk

source ${CONDA_BASE}/bin/activate atac_env

## The following line indicates the manual input in the job submission command line "sbatch script_name.sub <$1> <$2>"
SETNAME=$1
BASENAME=$2

INPATH="${PROJECT_DIR}/ATAC_seq/ATAC_data/"
SCPATH="${PROJECT_DIR}/ATAC_seq/scripts/"

mkdir -p ${INPATH}/Output/${BASENAME}

OUTDIR0=${PROJECT_DIR}/ATAC_seq/ATAC_data/Output/${BASENAME}/


## 		Analysis script for Steop01_ATAC_PE_Fastqc_TrimGalore.sub is as follows 

## 	Run FastQC to quality check the raw untrimmed fastqs ###
mkdir -p ${OUTDIR0}fastQC
mkdir -p ${OUTDIR0}fastQC/Pre-trimGalore
mkdir -p ${OUTDIR0}TrimGalore

## Load INput files

IN_FQ1=${INPATH}fastq/${SETNAME}/
## first read of pair fastQ
IN_FQ2=${INPATH}fastq/${SETNAME}/
## second read of pair fastQ

## Run FASTQC to check Read Quality
fastqc ${INFQ1}${BASENAME}_R1.fastq.gz -o ${OUTDIR0}fastQC/Pre-trimGalore -k 6 && \
fastqc ${INFQ2}${BASENAME}_R2.fastq.gz -o ${OUTDIR0}fastQC/Pre-trimGalore -k 6

##	 Run Notes for TrimGalore ##
        
## Pseudocode: Paired end 
## trim-galore --phred64<or phred33> --paired --fastqc --cores 8 --output_dir <output directory> <input A_R1.fastq.gz> <input A_R2.fastq.gz> <input B_R1.fastq.gz> <input B_R2.fastq.gz> 

## Phred Note: phred is a quality control syntax assignment for newer vs older sequencing methods Phred 33 is used in illumination 1.9+ and phred 64 is used on Sanger & Illumina 1.3. (Different symbol usage to demonstrate quality score set by sequencer)

## 'nextseq INT' Enables the cutadapt --nextseq-trim=3'CUTOFF option Note: This trimming is in common for the NextSeq- and NovaSeq-platforms, where basecalls without any signal are called as high-quality G bases. More on the issue of G-overcalling may be found here: https://sequencing.qcfail.com/articles/illumina-2-colour-chemistry-can-overcall-high-confidence-g-bases/. This is mutually exlusive with -q INT.


## 	Run TrimGalore! #

trim_galore --phred33 --paired --retain_unpaired --fastqc --cores 16 --nextseq 4 --output_dir ${OUTDIR0}TrimGalore ${IN_FQ1}${BASENAME}_R1.fastq.gz ${IN_FQ2}${BASENAME}_R2.fastq.gz

echo "TrimGalore trim and QC Complete!"
